# Hostinger (LiteSpeed/Apache) settings for the static site.

Options -Indexes

# The static site's index.html is the homepage. This folder also still contains an older
# WordPress install (index.php); listing index.html first is what keeps it out of the way.
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

# Always HTTPS, and one hostname: www redirects to the bare domain.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://wpcodie.com%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^www\.wpcodie\.com$ [NC]
  RewriteRule ^ https://wpcodie.com%{REQUEST_URI} [L,R=301]

  # Pages of the old WordPress theme demo that Google still lists. "Gone" (410) tells search
  # engines to drop them now, rather than retrying a 404 for weeks; /contact/ goes to the form.
  RewriteRule ^contact/?$ https://wpcodie.com/#contact [L,R=301,NE]
  RewriteRule ^(events|select-your-plan|restaurant|room|rooms|blog|sample-page|hello-world|shop|cart|checkout|my-account|category|tag|author|feed|comments/feed)(/.*)?$ - [G,L]
</IfModule>

AddType application/manifest+json .webmanifest

# Compression.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# Caching. Every JS, CSS and font file is built into /_astro/ with a content hash in its
# name, so it can be cached forever; HTML must be revalidated so a deploy shows up immediately.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(png|svg|ico|webmanifest)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
