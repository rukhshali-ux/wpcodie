---
// The page markup lives in src/site/Home.jsx and its behaviour in src/site/logic.js.
// Astro renders it to HTML at build time and hydrates it in the browser.
import Page from '../site/Page.jsx';
import { DESCRIPTION, SITE, TITLE, jsonLd } from '../site/seo.js';
import interFont from '../assets/fonts/inter-7.woff2?url';
import groteskFont from '../assets/fonts/space-grotesk-10.woff2?url';
// Order matters: it is the cascade order of the original design.
import '../assets/css/runtime.css';
import '../assets/css/styles.css';
import '../assets/css/page.css';
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{TITLE}</title>
<meta name="description" content={DESCRIPTION}>
<meta name="google-site-verification" content="6xpnHQO1K4-SMnQw-TFapgLuDd-eNZgH5oBuqQkA2X4">
<link rel="canonical" href={`${SITE}/`}>
<meta name="theme-color" content="#F5F4F0">
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<link rel="preload" href={interFont} as="font" type="font/woff2" crossorigin>
<link rel="preload" href={groteskFont} as="font" type="font/woff2" crossorigin>
<meta property="og:type" content="website">
<meta property="og:site_name" content="WPCodie">
<meta property="og:url" content={`${SITE}/`}>
<meta property="og:title" content={TITLE}>
<meta property="og:description" content={DESCRIPTION}>
<meta property="og:image" content={`${SITE}/og.png`}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={TITLE}>
<meta name="twitter:description" content={DESCRIPTION}>
<meta name="twitter:image" content={`${SITE}/og.png`}>
<!-- Design previews: ?preview=mobile turns on the rules under html.pv-mobile in page.css; ?preview=mobile2 adds html.pv-mobile2 on top. -->
<script is:inline>(function(){var m=/[?&]preview=(mobile2?)\b/.exec(location.search);if(m){document.documentElement.classList.add('pv-mobile');if(m[1]==='mobile2')document.documentElement.classList.add('pv-mobile2');}})();</script>
<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd())}></script>
</head>
<body>
<div id="dc-root"><div class="sc-host" data-sc-name="index"><Page client:load motion={true} intro={true} /></div></div>
</body>
</html>
