---
// Served by .htaccess (ErrorDocument 404) for any address that does not exist.
import '../assets/css/styles.css';
import '../assets/css/page.css';
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Page not found — WPCodie</title>
<meta name="robots" content="noindex">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
</head>
<body>
<main style="min-height:100vh;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;gap:20px;max-width:1280px;margin:0 auto;padding:32px">
  <a href="/" style="display:flex;align-items:center;gap:10px;color:#15181F">
    <span style="width:30px;height:30px;border-radius:8px;background:#2451B8;color:#F5F4F0;display:grid;place-items:center;font:700 15px 'Space Grotesk',sans-serif">W</span>
    <span style="font-family:'Space Grotesk',sans-serif;font-weight:600;font-size:19px;letter-spacing:-0.01em">WPCodie</span>
  </a>
  <h1 style="margin:0;font-family:'Space Grotesk',sans-serif;font-weight:600;font-size:clamp(2.25rem,5vw,3.5rem);line-height:1.05;letter-spacing:-0.03em">This page doesn't exist.</h1>
  <p style="margin:0;font-size:1.125rem;line-height:1.6;color:#4A4740">The link may be old, or the address mistyped.</p>
  <a href="/" style="display:inline-flex;align-items:center;font-weight:500;font-size:16px;padding:14px 28px;border-radius:8px;background:#2451B8;color:#F5F4F0">Back to the homepage →</a>
</main>
</body>
</html>
